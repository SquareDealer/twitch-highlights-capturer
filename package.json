{
  "name": "twitch-highlights-realtime",
  "version": "1.0.0",
  "description": "Хайлайты Twitch: сервис, который сам находит моменты в эфирах и нарезает клипы",
  "private": true,
  "scripts": {
    "start": "tsx src/service/main.ts",
    "service": "tsx src/service/main.ts",
    "service:build": "npm run web:build",
    "web:build": "vite build --config vite.web.config.ts",
    "web:dev": "vite --config vite.web.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "better-sqlite3": "^13.2.0",
    "google-auth-library": "^11.3.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
